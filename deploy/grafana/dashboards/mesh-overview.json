{
  "title": "OPNmesh — Mesh Overview",
  "uid": "opnmesh-overview",
  "schemaVersion": 39,
  "refresh": "10s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Per-tunnel throughput (rx)",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "rate(wireguard_peer_rx_bytes_total[1m])",
          "legendFormat": "{{node}} ← {{public_key}}"
        }
      ]
    },
    {
      "id": 2,
      "title": "Per-tunnel throughput (tx)",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "rate(wireguard_peer_tx_bytes_total[1m])",
          "legendFormat": "{{node}} → {{public_key}}"
        }
      ]
    },
    {
      "id": 3,
      "title": "Handshake age (s)",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "time() - wireguard_peer_latest_handshake_seconds",
          "legendFormat": "{{node}} {{public_key}}"
        }
      ]
    },
    {
      "id": 4,
      "title": "Site-to-site matrix (bytes/s)",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 8, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "sum by (name) (rate(opnmesh_nft_counter_bytes[1m]))",
          "legendFormat": "{{name}}"
        }
      ]
    },
    {
      "id": 5,
      "title": "Drift / errors / pending",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 16, "w": 24, "h": 6 },
      "targets": [
        { "expr": "opnmesh_node_drift", "legendFormat": "drift {{node}}" },
        { "expr": "opnmesh_node_reconcile_error", "legendFormat": "error {{node}}" },
        { "expr": "opnmesh_pending_nodes", "legendFormat": "pending nodes" }
      ]
    }
  ]
}
