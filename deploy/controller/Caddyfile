# OPNmesh controller — TLS termination.
#
# OPNMESH_SITE is either a public DNS name (Caddy obtains Let's Encrypt
# certificates automatically; ports 80/443 must be reachable from the
# internet) or an IP address / private name (Caddy issues certificates from
# its own private CA, whose root the controller serves at /ca.crt so
# gateways can pin it at install time).

{$OPNMESH_SITE} {
	encode zstd gzip
	reverse_proxy controller:3000 {
		# Server-Sent Events must stream, not buffer.
		flush_interval -1
	}
}
