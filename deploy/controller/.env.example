# OPNmesh controller — copy to .env and edit.

# The hostname or IP address this controller is reached at.
#   A public DNS name  → Caddy obtains Let's Encrypt certificates (80/443 must be reachable).
#   An IP address      → Caddy issues certificates from a private CA that gateways pin.
OPNMESH_SITE=mesh.example.com

# The URL gateways and browsers use; normally https://<OPNMESH_SITE>.
OPNMESH_PUBLIC_URL=https://mesh.example.com

# Ports Caddy listens on. Change if 80/443 are taken on this host.
OPNMESH_HTTP_PORT=80
OPNMESH_HTTPS_PORT=443

# Image to run. Pin a version for reproducible upgrades.
OPNMESH_IMAGE=ghcr.io/coppingethan/opnmesh:latest
