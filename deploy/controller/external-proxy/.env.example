# OPNmesh controller behind your own reverse proxy. Copy to .env and edit.
# See docs/REVERSE-PROXY.md.

# The address people and gateways use: the name your proxy serves over HTTPS.
OPNMESH_PUBLIC_URL=https://mesh.example.com

# Where the controller listens for the proxy: a private address of this host
# and a port. Never 0.0.0.0. Only the addresses in ./backend-allow may connect.
OPNMESH_BACKEND_BIND=10.0.0.5:3000

# How many reverse proxies sit in front of the controller (see
# OPNMESH_TRUST_PROXY in docs/REVERSE-PROXY.md). One for a single proxy.
OPNMESH_TRUST_PROXY=1

# Image to run, pinned to a release by version and digest (each release's
# notes give both). To upgrade, replace the whole value with the new
# release's, then docker compose pull && docker compose up -d.
OPNMESH_IMAGE=ghcr.io/coppingethan/opnmesh:2.1.4@sha256:4afa4b8f618f29f0362e04cc59e75067c4bcca307df362d94a4a80a14eb447f7
