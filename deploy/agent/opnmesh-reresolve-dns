#!/usr/bin/env bash
# Re-resolve each peer's Endpoint hostname and re-set it if the address moved.
# Based on wg-quick's own approach, but idempotent and safe to run on a timer.
# Usage: opnmesh-reresolve-dns <interface>
set -euo pipefail

IFACE="${1:-wg0}"
CONF="/etc/opnmesh/${IFACE}.conf"
[ -f "$CONF" ] || exit 0

peer=""
endpoint=""
while IFS= read -r line; do
  line="$(echo "$line" | sed 's/#.*//;s/^[[:space:]]*//;s/[[:space:]]*$//')"
  case "$line" in
    "[Peer]") peer=""; endpoint="" ;;
    PublicKey*) peer="${line#*= }" ;;
    Endpoint*)
      endpoint="${line#*= }"
      host="${endpoint%:*}"
      port="${endpoint##*:}"
      # Only hostnames need re-resolution.
      if ! echo "$host" | grep -Eq '^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$'; then
        if [ -n "$peer" ]; then
          wg set "$IFACE" peer "$peer" endpoint "${host}:${port}" 2>/dev/null || true
        fi
      fi
      ;;
  esac
done < "$CONF"
