# OPNmesh control node — copy to .env.local and fill in. Never commit .env.local.
# Every port is configurable; these are only defaults.

# Admin UI (humans)
OPNMESH_WEB_PORT=443
# Agent-facing API + Prometheus scrape target (nodes pull from here over HTTPS)
OPNMESH_API_PORT=8443

# Observability
OPNMESH_PROMETHEUS_PORT=9090
OPNMESH_ALERTMANAGER_PORT=9093
OPNMESH_GRAFANA_PORT=3001

# Session signing (any long random string)
OPNMESH_SESSION_SECRET=

# SMTP for Alertmanager + the UI "Send test email" button
OPNMESH_SMTP_HOST=
OPNMESH_SMTP_PORT=587
OPNMESH_SMTP_USER=
OPNMESH_SMTP_PASSWORD=
OPNMESH_SMTP_FROM=opnmesh@example.com
OPNMESH_ALERT_TO=ops@example.com

# Dead-man's switch: external URL pinged periodically so the control node's own
# death is noticed by something outside it.
OPNMESH_DEADMAN_URL=
