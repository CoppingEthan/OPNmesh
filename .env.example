# OPNmesh controller environment. Copy to .env for local development.
# Every value has a default; secrets are generated on first start if absent.

# Where SQLite and generated secrets live (a Docker volume in production).
OPNMESH_DATA_DIR=./data

# Public URL gateways and browsers use to reach the controller.
# Printed into install commands and client invite links.
OPNMESH_PUBLIC_URL=http://localhost:3000

# 32+ random bytes, hex. Encrypts client private keys and UniFi credentials at
# rest. Generated into $OPNMESH_DATA_DIR/secret.key if unset.
OPNMESH_SECRET=

# Allow plain http:// for gateway enrolment. Simulation and local dev only.
OPNMESH_INSECURE_HTTP=1

# How many reverse proxies sit in front of the controller (Caddy, or your own).
# The client address for login throttling and the audit log is then taken from
# X-Forwarded-For, counted from the right so a client cannot forge it.
# 0 ignores the header.
OPNMESH_TRUST_PROXY=0
