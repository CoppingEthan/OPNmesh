# OPNmesh environment — copy to .env.local and fill in. .env.local is gitignored.
# All values empty on purpose: secrets come from the environment, never the repo.

# Control panel web/API (defaults shown; every port is configurable, nothing is hardcoded)
OPNMESH_WEB_PORT=
OPNMESH_SESSION_SECRET=

# SMTP for Alertmanager / test emails
OPNMESH_SMTP_HOST=
OPNMESH_SMTP_PORT=
OPNMESH_SMTP_USER=
OPNMESH_SMTP_PASSWORD=
OPNMESH_SMTP_FROM=

# Observability stack ports
OPNMESH_PROMETHEUS_PORT=
OPNMESH_ALERTMANAGER_PORT=
OPNMESH_GRAFANA_PORT=

# Dead-man's switch: external heartbeat URL pinged periodically by the control node
OPNMESH_DEADMAN_URL=
