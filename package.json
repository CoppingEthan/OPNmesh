{
  "name": "opnmesh",
  "version": "2.0.0-dev",
  "private": true,
  "description": "Open-source WireGuard site-to-site mesh with roaming clients, a live traffic dashboard and UniFi router automation",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "next lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ubuntu": "node scripts/run-in-ubuntu.mjs npm test",
    "goldens:update": "cross-env UPDATE_GOLDENS=1 vitest run test/core/golden.test.ts",
    "db:generate": "drizzle-kit generate",
    "agent:build": "node scripts/agent-build.mjs",
    "agent:test": "node scripts/agent-test.mjs",
    "sim:up": "node scripts/sim.mjs up",
    "sim:down": "node scripts/sim.mjs down",
    "sim:logs": "node scripts/sim.mjs logs",
    "sim:test": "cross-env RUN_SIM=1 vitest run sim/test --testTimeout 600000 --no-file-parallelism",
    "check": "npm run typecheck && npm test && npm run agent:test",
    "ui:test": "npm run build && node scripts/ui-smoke.mjs",
    "check:full": "npm run check && npm run ui:test && npm run sim:up && npm run sim:test"
  },
  "dependencies": {
    "argon2": "^0.45.1",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.41.0",
    "next": "^16.3.4",
    "nodemailer": "^10.0.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.19.0",
    "@types/nodemailer": "^8.0.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "cross-env": "^7.0.3",
    "drizzle-kit": "^0.31.10",
    "playwright": "^1.63.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.0"
  }
}
