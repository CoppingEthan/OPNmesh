{
  "name": "opnmesh",
  "version": "0.1.0",
  "private": true,
  "description": "Self-hosted WireGuard mesh management for small multi-site networks",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "goldens:update": "cross-env UPDATE_GOLDENS=1 vitest run test/golden.test.ts",
    "mesh:up": "tsx docker/genconfigs.ts && docker compose -f docker/docker-compose.yml build gw-a && docker compose -f docker/docker-compose.yml up -d",
    "mesh:down": "docker compose -f docker/docker-compose.yml --profile traffic down -v",
    "mesh:logs": "docker compose -f docker/docker-compose.yml logs -f",
    "mesh:test": "cross-env RUN_MESH_TESTS=1 vitest run test/integration --testTimeout 180000 --no-file-parallelism",
    "mesh:traffic": "docker compose -f docker/docker-compose.yml --profile traffic up -d traffic-gen",
    "mesh:chaos": "tsx docker/chaos.ts"
  },
  "dependencies": {
    "yaml": "^2.6.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "cross-env": "^7.0.3",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
